# Public URL of the NestJS API. Do not include a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public URL used to construct OAuth callback URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings safe to expose to browser code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy alternative to NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# Define only one of these two key variables.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret currently used by app/api/keep-alive.
# Never prefix this value with NEXT_PUBLIC_ and never commit a real value.
# The keep-alive implementation is scheduled for review in P0.2.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
