generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Test {
  id        String   @id
  title     String
  testCode  String?
  // Store the complex nested IELTS structure (passages, questionGroups, questions)
  // as a JSONB object to maintain flexibility and avoid over-engineering relational tables
  content   Json
  
  attempts  Attempt[]
  comments  Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attempt {
  id               String   @id @default(uuid())
  testId           String
  test             Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  
  score            Int
  totalQuestions   Int
  timeTakenSeconds Int
  mode             String   // e.g., "Full test", "Luyện tập"
  
  createdAt        DateTime @default(now())
}

model Comment {
  id         String   @id @default(uuid())
  testId     String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  
  authorName String
  content    String
  
  createdAt  DateTime @default(now())
}
